# AVORA runtime — copy to .env.local and fill only the providers you use.
NODE_ENV="development"
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Adaptive Tutor / AI provider
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL=""
AI_DAILY_REQUEST_LIMIT_PER_USER=""
AI_MONTHLY_REQUEST_LIMIT_GLOBAL=""
AI_MONTHLY_BUDGET_USD=""

# Text-first teaching is the learner-facing default. Voice implementation is preserved behind this flag.
NEXT_PUBLIC_VOICE_TEACHING_ENABLED="false"

# Email — configure the provider used by the deployment.
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME=""
EMAIL_FROM=""
EMAIL_FROM_NAME="AVORA"

# Billing
PAYSTACK_SECRET_KEY=""
PAYSTACK_PLAN_CODE_FAMILY_MONTHLY=""
AVORA_FAMILY_MONTHLY_PRICE_NGN="5000"

# Server jobs
CRON_SECRET=""
